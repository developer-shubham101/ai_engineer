# Copy this file to .env and fill in your keys

# OpenWeatherMap API key — get one free at https://openweathermap.org/api
# Without this, get_weather falls back to demo data
OPENWEATHER_API_KEY=

# SerpAPI key — get one at https://serpapi.com
# Without this, web_search uses DuckDuckGo (free, no key needed)
SERPAPI_KEY=
